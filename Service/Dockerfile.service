FROM node:22.21.1-bookworm-slim

# ping and curl (timedcurl.sh) are what the frequent batch shells out to.
# cron schedules the batches until the in-process scheduler replaces it (plan, Phase 4).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        iputils-ping curl ca-certificates cron \
    && rm -rf /var/lib/apt/lists/*

# Ookla Speedtest CLI, the official client (statically linked). Pinned version, verified against
# the SHA-256 recorded for each architecture. Personal, non-commercial use only (see its EULA).
ARG OOKLA_VERSION=1.2.0
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
        amd64) arch=x86_64;  sha=5690596c54ff9bed63fa3732f818a05dbc2db19ad36ed68f21ca5f64d5cfeeb7 ;; \
        arm64) arch=aarch64; sha=3953d231da3783e2bf8904b6dd72767c5c6e533e163d3742fd0437affa431bd3 ;; \
        armhf) arch=armhf;   sha=e45fcdebbd8a185553535533dd032d6b10bc8c64eee4139b1147b9c09835d08d ;; \
        *) echo "No Ookla Speedtest CLI build for $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/speedtest.tgz \
        "https://install.speedtest.net/app/cli/ookla-speedtest-${OOKLA_VERSION}-linux-${arch}.tgz"; \
    echo "${sha}  /tmp/speedtest.tgz" | sha256sum -c -; \
    tar xzf /tmp/speedtest.tgz -C /usr/local/bin speedtest; \
    rm /tmp/speedtest.tgz; \
    speedtest --version | head -1

WORKDIR /var/smart-home

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production && yarn cache clean

COPY ./ ./
RUN chmod +x containerScripts/*.sh timedcurl.sh

CMD ["/var/smart-home/containerScripts/init-container-script.sh"]
