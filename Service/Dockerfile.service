FROM node:22.21.1-bookworm-slim

# ping, curl (timedcurl.sh) and speedtest-cli are what the commands shell out to.
# speedtest-cli is Debian's package of the sivel Python tool the parser expects.
# cron schedules the batches until the in-process scheduler replaces it (plan, Phase 4).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        iputils-ping curl ca-certificates speedtest-cli cron \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/smart-home

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production && yarn cache clean

COPY ./ ./
RUN chmod +x containerScripts/*.sh timedcurl.sh

CMD ["/var/smart-home/containerScripts/init-container-script.sh"]
