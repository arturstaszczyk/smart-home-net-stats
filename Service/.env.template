# Copy to .env (next to docker-compose.yml) and fill in. .env is git-ignored and not copied
# into the image. Used both by `docker compose` and by local `yarn standalone-*` runs.

# LAN address of the infrastructure host (InfluxDB).
INFLUX_HOST=192.168.1.10
INFLUX_PORT=8086
INFLUX_RETENTION=autogen

# Must match INFLUX_DB / INFLUX_USER / INFLUX_PASS in Infrastructure/.env.
INFLUX_DB=smart-home-db
INFLUX_USER=smart-home-user
INFLUX_PASS=change-me

# Your router's address; it is pinged and curled with the other targets.
ROUTER_1=192.168.1.1
# Tag that tells the Pis apart in Grafana. Dashboard v2.0 picks up new names on its own; v1.0 only lists pi3, pi4, pi5.
COMPUTER_NAME=pi4
# Minute of every hour (0-59) at which this Pi runs its speed test. Each test saturates the whole
# internet connection for ~25 s, so give every Pi its own minute, spread evenly (3 Pis: 0, 20, 40).
SPEED_TEST_MINUTE=6
# Optional: Ookla server ID to always test against, so results are comparable over time and across
# Pis. Use the same ID on every Pi. Empty = nearest server each time. List: speedtest --servers
SPEED_TEST_SERVER_ID=

# --- Docker only ----------------------------------------------------------------
# Leave as-is to build locally; set to your Docker Hub tag to pull instead,
# e.g. <docker_hub_id>/smart-home:service
SERVICE_IMAGE=smart-home-service
# Host directory for logs (<DATA_DIR>/service/).
DATA_DIR=/var/lib/smart-home
