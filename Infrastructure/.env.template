# Copy to .env (next to docker-compose.yml) and fill in. .env is git-ignored.

# Host directory for persistent data (influx/ and grafana/).
DATA_DIR=/var/lib/smart-home

# The account the service writes with and Grafana reads with.
# Must match INFLUX_DB / INFLUX_USER / INFLUX_PASS in every Pi's Service/.env.
INFLUX_DB=smart-home-db
INFLUX_USER=smart-home-user
INFLUX_PASS=change-me

# Admin user, for user management.
# These four values are only applied on first start with an empty data dir.
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASS=change-me-too

# Set to false only temporarily, e.g. to create users on an existing database (see README.md).
INFLUX_AUTH_ENABLED=true
